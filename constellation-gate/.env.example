L9_ENVIRONMENT=local
GATE_LOCAL_NODE=gate

HOST=0.0.0.0
PORT=9000

L9_DEV_MODE=true
L9_REQUIRE_SIGNATURE=false

# INGRESS TRUST BOUNDARY (staging / prod only).
#
# Gate accepts a canonical TransportPacket over HTTP. The packet's own hashes
# prove it is well-formed; they do NOT prove the sender is entitled to route
# work. In `staging` and `prod` startup FAILS unless one boundary is named:
#
#   (a) L9_REQUIRE_SIGNATURE=true  + L9_VERIFYING_KEYS_JSON populated, or
#   (b) L9_TRUSTED_NETWORK_INGRESS=true -- an explicit operator assertion that
#       ingress is fronted by an authenticated network boundary (mesh mTLS /
#       private ingress). This relaxes nothing; packet validation stays on as
#       defense in depth. It only records which mechanism is authoritative.
#
# `local`, `dev` and `test` are unaffected.
L9_TRUSTED_NETWORK_INGRESS=false

L9_SIGNING_KEY=
L9_SIGNING_KEY_ID=
L9_SIGNING_ALGORITHM=
# JSON object mapping key_id -> key_value for multi-key signature verification.
# Must be valid JSON. Example: {"key-1": "abc123", "key-2": "def456"}
L9_VERIFYING_KEYS_JSON={}

L9_ALLOWED_ACTIONS=
L9_ALLOWED_PACKET_TYPES=request,command,delegation,replay_request
L9_REQUIRE_IDEMPOTENCY_FOR_ACTIONS=

L9_ALLOWED_CLOCK_SKEW_SECONDS=30
L9_MAX_PACKET_BYTES=262144
L9_MAX_HOP_DEPTH=64
L9_MAX_DELEGATION_DEPTH=8
L9_MAX_ATTACHMENTS=32
L9_MAX_ATTACHMENT_SIZE_BYTES=10485760
L9_ATTACHMENT_ALLOWED_SCHEMES=
L9_ALLOW_PRIVATE_ATTACHMENT_HOSTS=false

L9_REPLAY_ENABLED=true
L9_VERIFY_HOP_SIGNATURES=false

# Actions this deployment must be able to route before GET /v1/ready reports
# ready (503 otherwise). /v1/health remains a pure liveness probe.
# Example for the canonical converge path: L9_REQUIRED_READY_ACTIONS=converge
L9_REQUIRED_READY_ACTIONS=

# Canonical admin token env var (matches SDK GATE_ADMIN_TOKEN).
# L9_GATE_ADMIN_TOKEN is accepted as a backward-compatible alias.
GATE_ADMIN_TOKEN=

# Optional path to workflow definitions YAML file.
# If unset, workflow engine starts with no definitions (direct dispatch is used for all actions).
# If set, the file must exist and be valid YAML or startup will fail.
# GATE_WORKFLOW_CONFIG_PATH=engine/workflows.yaml
